# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the SERVICE ROLE key here, not the anon/public key.
# This server runs server-side only (stdio/local process), so it's safe
# the same way an Edge Function is — never expose this key in a client bundle.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: only needed once OpenTelemetry export is wired up (see src/tracing.js)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Required by the print_packing_slip tool. A TCGplayer Seller Portal session cookie,
# captured from a logged-in browser tab: DevTools -> Network tab -> any request ->
# right-click -> Copy as cURL -> pull out the value of the Cookie header.
# Expires/rotates periodically — a 401/403 from the tool means it needs refreshing.
TCGPLAYER_COOKIE=
